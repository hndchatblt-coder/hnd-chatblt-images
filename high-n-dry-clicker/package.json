{
  "name": "high-n-dry-clicker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "High N' Dry: Clicker \u2014 one screen, one number, one thumb.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:assert": "tsx sim/assert.ts",
    "playbot": "tsx sim/playbot.ts",
    "gates": "npm run typecheck && npm run test && npm run sim:assert",
    "dev": "vite",
    "build": "vite build",
    "build:play": "vite build && mkdir -p play && cp dist/index.html play/index.html",
    "shots": "vite build && tsx sim/shots.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright": "^1.62.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.4"
  }
}
