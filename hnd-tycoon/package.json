{
  "name": "hnd-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sim": "tsx scripts/sim.ts",
    "floor": "tsx scripts/floor.ts",
    "balance": "tsx scripts/balance.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "boundaries": "node scripts/check-boundaries.mjs",
    "gate": "npm run boundaries && npm run typecheck && npm run test && npm run balance",
    "dev": "vite",
    "build": "vite build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
