{
  "name": "hnd-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sim": "tsx scripts/sim.ts",
    "floor": "tsx scripts/floor.ts",
